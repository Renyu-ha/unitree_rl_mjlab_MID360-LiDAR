# Use the SDK shipped with this checkout, including the matching DDS libraries.
if(NOT TARGET unitree_sdk2)
  get_filename_component(UNITREE_REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
  set(UNITREE_SDK2_ROOT "${UNITREE_REPO_ROOT}/unitree_sdk2" CACHE PATH "Matching Unitree SDK2 checkout")
  if(NOT EXISTS "${UNITREE_SDK2_ROOT}/CMakeLists.txt")
    message(FATAL_ERROR "unitree_sdk2 is missing; copy the submodule contents or clone with --recurse-submodules")
  endif()
  set(BUILD_EXAMPLES OFF CACHE BOOL "Build SDK examples" FORCE)
  add_subdirectory("${UNITREE_SDK2_ROOT}" "${CMAKE_BINARY_DIR}/sdk2" EXCLUDE_FROM_ALL)
  target_include_directories(unitree_sdk2 BEFORE INTERFACE "${UNITREE_REPO_ROOT}/patches/unitree_sdk2/include")
  foreach(_sdk_target unitree_sdk2 ddsc ddscxx)
    get_target_property(_sdk_file ${_sdk_target} IMPORTED_LOCATION)
    file(SIZE "${_sdk_file}" _sdk_size)
    if(_sdk_size LESS 512)
      file(READ "${_sdk_file}" _sdk_link)
      string(STRIP "${_sdk_link}" _sdk_link)
      get_filename_component(_sdk_directory "${_sdk_file}" DIRECTORY)
      if(EXISTS "${_sdk_directory}/${_sdk_link}")
        set_target_properties(${_sdk_target} PROPERTIES IMPORTED_LOCATION "${_sdk_directory}/${_sdk_link}")
      endif()
    endif()
  endforeach()
endif()
